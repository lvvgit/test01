apiVersion: apps/v1
kind: Deployment
metadata:
  name: course-app-deployment
  labels:
    app: course-app
spec:
  replicas: 5
  strategy:
     type: Recreate
#    type: RollingUpdate
#    rollingUpdate:
#      maxSurge: 2          # +2
#      maxUnavailable: 1
  selector:
    matchLabels:
      app: course-app
  template:
    metadata:
      labels:
        app: course-app
    spec:
      containers:
      - name: course-app
        image: lvv77/course-app:v7.0
        env:
        - name: APP_COLOR
          valueFrom:
            configMapKeyRef:
              name: course-app-config
              key: APP_COLOR
        ports:
        - containerPort: 8080
        livenessProbe:
          httpGet:
            path: /healthz
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 10

---
apiVersion: v1
kind: Service
metadata:
  name: course-app-service
spec:
  type: NodePort
  selector:
    app: course-app
  ports:
    - protocol: TCP
      port: 80
      targetPort: 8080
      nodePort: 30080
